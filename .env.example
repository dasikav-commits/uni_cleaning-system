# Copy to .env (or .env.local) and fill in the values.

# --- Database (Supabase Postgres) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# Server-only. Used by `npm run seed` and the test-user setup. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Business calendar ---
# Time zone used to decide "today" and monthly reporting periods (default Asia/Colombo).
BUSINESS_TIME_ZONE="Asia/Colombo"

# --- Monthly processing (cron) ---
# Shared secret for /api/cron/monthly-reports. Vercel Cron sends `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=""
# Optional alternative secret name for other schedulers (either one is accepted).
MONTHLY_REPORT_CRON_SECRET=""
# Id (public."User".id) of an existing user, e.g. a GAA, that automated reports are attributed to in the audit log.
MONTHLY_REPORT_SYSTEM_ACTOR_ID=""

# --- Test accounts ---
# The test-user setup page creates accounts with well-known passwords. It is disabled in production
# unless this is "true". Only enable it temporarily.
ALLOW_TEST_USER_INIT="false"
