generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Logins of the cleaning monitoring process.
/// DEPUTY_REGISTRAR is the administrator: manages users, locations and the BOQ,
/// gathers the evaluation reports and prepares the three monthly reports.
/// Every other role submits evaluation reports for the locations assigned to it.
enum UserRole {
  DEPUTY_REGISTRAR
  PHI
  FACULTY_COORDINATOR
  SUB_WARDEN
  CURATOR
  UNIT_OFFICER
}

/// How a BOQ location is grouped (drives filtering and which login normally reports it).
enum LocationCategory {
  FACULTY
  ADMINISTRATION
  HALL
  COMMON_UNIT
  LANDSCAPE
  EXTERNAL_SERVICE
}

/// SCHEDULED: each BOQ row is evaluated by ticking its scheduled occurrences.
/// RATE_BASED: each row is paid as quantity x rate (toilet pits, stray animals).
enum EvaluationFormat {
  SCHEDULED
  RATE_BASED
}

enum BoqFrequency {
  TWICE_DAILY
  DAILY
  WEEKLY
  MONTHLY
  ANNUAL
  WHEN_NECESSARY
  ON_REQUEST
  PER_SERVICE
}

enum EvaluationReportStatus {
  DRAFT
  SUBMITTED
  RETURNED
  ACCEPTED
}

enum PaymentReportStatus {
  DRAFT
  FINALIZED
}

enum TaskCategory {
  DAILY
  WEEKLY
  MONTHLY
}

enum TaskFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum EvaluationResult {
  P
  X
  NA
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  RESUBMITTED
  CORRECTION_REQUESTED
  ADMIN_APPROVED
  ADMIN_REJECTED
  VC_PENDING
  VC_APPROVED
  VC_REJECTED
  CLARIFICATION_REQUESTED
}

enum PhiMonthlyAttendanceCategory {
  HALF_DAY_EMPLOYEES
  HALF_DAY_GRASS_CUTTERS_GULLY_CLEANER_TRACTOR_OPERATOR
  HALF_DAY_SUPERVISORS
  ABSENT_EMPLOYEES
  ABSENT_GRASS_CUTTERS_GULLY_CLEANER_TRACTOR_OPERATOR
  ABSENT_SUPERVISORS
}

enum AdministrationDecision {
  APPROVE
  CORRECTION
  REJECT
}

enum PaymentRecommendationStatus {
  DRAFT
  FINALIZED
  VC_PENDING
  VC_APPROVED
  VC_REJECTED
  CLARIFICATION_REQUESTED
}

enum VCDecision {
  APPROVE
  REJECT
  CLARIFICATION
}

enum ActivityAction {
  LOGIN
  LOGOUT
  USER_CREATED
  USER_UPDATED
  USER_ROLE_CHANGED
  USER_ACTIVATED
  USER_DEACTIVATED
  LOCATION_CREATED
  LOCATION_UPDATED
  LOCATION_ACTIVATED
  LOCATION_DEACTIVATED
  CLEANING_TASK_CREATED
  CLEANING_TASK_UPDATED
  CLEANING_TASK_ACTIVATED
  CLEANING_TASK_DEACTIVATED
  LOCATION_TASK_CREATED
  LOCATION_TASK_UPDATED
  LOCATION_TASK_ACTIVATED
  LOCATION_TASK_DEACTIVATED
  EVALUATING_OFFICER_ASSIGNED
  EVALUATING_OFFICER_ASSIGNMENT_ACTIVATED
  EVALUATING_OFFICER_ASSIGNMENT_DEACTIVATED
  PHI_ASSIGNED
  PHI_ASSIGNMENT_ACTIVATED
  PHI_ASSIGNMENT_DEACTIVATED
  DAILY_EVALUATION_UPDATED
  ATTENDANCE_EVALUATION_CREATED
  ATTENDANCE_EVALUATION_UPDATED
  ATTENDANCE_EVALUATION_FINALIZED
  DAILY_EVALUATION_CREATED
  DAILY_EVALUATION_FINALIZED
  DAILY_EVALUATION_LOCKED
  ATTENDANCE_CREATED
  ATTENDANCE_FINALIZED
  ATTENDANCE_LOCKED
  MONTHLY_REPORT_GENERATED
  REPORT_SUBMITTED
  REPORT_RESUBMITTED
  ADMIN_APPROVED
  ADMIN_REJECTED
  CORRECTION_REQUESTED
  PAYMENT_RECOMMENDATION_CREATED
  PAYMENT_RECOMMENDATION_SUBMITTED
  PAYMENT_RECOMMENDATION_FINALIZED
  FINAL_REPORT_PDF_GENERATED
  FINAL_REPORT_EXCEL_GENERATED
  PAYMENT_ALLOCATION_UPDATED
  ADDITIONAL_TASK_ADDED
  VC_APPROVED
  VC_REJECTED
  CLARIFICATION_REQUESTED
  WORKER_CREATED
  WORKER_UPDATED
  WORKER_ACTIVATED
  WORKER_DEACTIVATED
  WORKER_ASSIGNED
  WORKER_ASSIGNMENT_UPDATED
  WORKER_ASSIGNMENT_ACTIVATED
  WORKER_ASSIGNMENT_DEACTIVATED
  BOQ_IMPORTED
  BOQ_ITEM_CREATED
  BOQ_ITEM_UPDATED
  REPORTING_ASSIGNMENT_CREATED
  REPORTING_ASSIGNMENT_UPDATED
  EVALUATION_REPORT_STARTED
  EVALUATION_REPORT_UPDATED
  EVALUATION_REPORT_SUBMITTED
  EVALUATION_REPORT_RETURNED
  EVALUATION_REPORT_ACCEPTED
  EVALUATION_REPORT_REOPENED
  PHI_DAILY_ATTENDANCE_SAVED
  PAYMENT_REPORT_PREPARED
  PAYMENT_REPORT_UPDATED
  PAYMENT_REPORT_FINALIZED
  PAYMENT_REPORT_REOPENED
}

enum NotificationEvent {
  MONTHLY_REPORT_AUTOMATICALLY_SUBMITTED
  ADMINISTRATION_APPROVED
  CORRECTION_REQUESTED
  ADMINISTRATION_REJECTED
  PAYMENT_RECOMMENDATION_CREATED
  PAYMENT_RECOMMENDATION_SUBMITTED
  PAYMENT_RECOMMENDATION_FINALIZED
  VC_APPROVED
  VC_REJECTED
  VC_REQUESTED_CLARIFICATION
  EVALUATION_REPORT_SUBMITTED
  EVALUATION_REPORT_RETURNED
  EVALUATION_REPORT_ACCEPTED
  PHI_ATTENDANCE_SUBMITTED
  PAYMENT_REPORT_FINALIZED
}

model User {
  id          String   @id
  name        String
  email       String   @unique
  role        UserRole
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  evaluatingOfficerAssignments EvaluatingOfficerAssignment[]
  phiAssignments               PHIAssignment[]
  evaluations                  DailyCleaningEvaluation[]
  attendances                  WorkerAttendance[]
  dailyAttendanceEvaluations    DailyAttendanceEvaluation[]
  phiMonthlyAttendanceReports   PhiMonthlyAttendanceReport[]
  phiMonthlyAttendanceReviews   PhiMonthlyAttendanceReview[]
  administrationReviews        AdministrationReview[]
  createdRecommendations       PaymentRecommendation[]
  submittedRecommendations     PaymentRecommendation[] @relation("PaymentRecommendationSubmitter")
  finalizedRecommendations     PaymentRecommendation[] @relation("PaymentRecommendationFinalizer")
  taskCalculationChanges       PaymentTaskCalculation[]
  workerCalculationChanges     PaymentWorkerCalculation[]
  createdAdditionalTasks       AdditionalCleaningTask[]
  vcApprovals                  VCApproval[]
  activityLogs                 ActivityLog[]
  notifications                Notification[]

  reportingAssignments         ReportingAssignment[]
  createdEvaluationReports     EvaluationReport[]        @relation("EvaluationReportCreator")
  submittedEvaluationReports   EvaluationReport[]        @relation("EvaluationReportSubmitter")
  reviewedEvaluationReports    EvaluationReport[]        @relation("EvaluationReportReviewer")
  phiDailyAttendances          PhiDailyAttendance[]
  createdPaymentReports        MonthlyPaymentReport[]    @relation("PaymentReportCreator")
  finalizedPaymentReports      MonthlyPaymentReport[]    @relation("PaymentReportFinalizer")
}

model Location {
  id               String           @id @default(cuid())
  code             String           @unique
  name             String
  /// Line number (1-28) in the "Cleaning & Janitorial Services" report.
  boqNumber        Int?             @unique
  /// Short heading used in the "Amount of work done" report (e.g. BSF, FAS).
  shortName        String?
  /// Line description, e.g. "Cleaning and Janitorial Services at the Medical Centre".
  boqDescription   String?
  category         LocationCategory @default(COMMON_UNIT)
  evaluationFormat EvaluationFormat @default(SCHEDULED)
  /// Fixed monthly BOQ amount. Required for RATE_BASED services; for SCHEDULED
  /// locations it is optional and defaults to the sum of the BOQ items.
  boqAmount        Decimal?         @db.Decimal(15, 2)
  minimumWorkers   Int?
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  boqItems                    BoqItem[]
  reportingAssignments        ReportingAssignment[]
  evaluationReports           EvaluationReport[]
  paymentReportLines          MonthlyPaymentReportLine[]

  locationTasks               LocationTask[]
  workerAssignments           WorkerLocationAssignment[]
  evaluatingOfficerAssignments EvaluatingOfficerAssignment[]
  phiAssignments              PHIAssignment[]
  dailyEvaluations            DailyCleaningEvaluation[]
  attendances                 WorkerAttendance[]
  dailyAttendanceEvaluations   DailyAttendanceEvaluation[]
  monthlyReports              MonthlyEvaluationReport[]
  additionalCleaningTasks     AdditionalCleaningTask[]
}

// ---------------------------------------------------------------------------
// Legacy models of the earlier task / worker / Vice-Chancellor workflow.
// They are no longer used by the application (replaced by BoqItem,
// EvaluationReport, PhiDailyAttendance and MonthlyPaymentReport) and are kept
// only so existing data is not dropped. PhiMonthlyAttendance*, ActivityLog and
// Notification further below are still in use.
// ---------------------------------------------------------------------------

model CleaningTask {
  id          String        @id @default(cuid())
  name        String
  category    TaskCategory
  frequency   TaskFrequency
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  locationTasks LocationTask[]
}

model LocationTask {
  id                 String   @id @default(cuid())
  locationId         String
  taskId             String
  frequency          TaskFrequency
  allocatedAmount    Decimal  @db.Decimal(15, 2)
  active             Boolean  @default(true)
  isAdditional       Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  location           Location               @relation(fields: [locationId], references: [id])
  task               CleaningTask           @relation(fields: [taskId], references: [id])
  evaluations        DailyCleaningEvaluation[]
  monthlySummaries   MonthlyTaskSummary[]
  paymentCalculations PaymentTaskCalculation[]

  @@unique([locationId, taskId])
  @@index([locationId])
  @@index([taskId])
}

model CleaningWorker {
  id          String   @id @default(cuid())
  name        String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locationAssignments WorkerLocationAssignment[]
  attendances          WorkerAttendance[]
  monthlySummaries     MonthlyWorkerSummary[]
  paymentCalculations  PaymentWorkerCalculation[]
}

model WorkerLocationAssignment {
  id              String   @id @default(cuid())
  workerId        String
  locationId      String
  allocatedAmount Decimal  @db.Decimal(15, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  worker                 CleaningWorker         @relation(fields: [workerId], references: [id])
  location               Location               @relation(fields: [locationId], references: [id])
  monthlyWorkerSummaries  MonthlyWorkerSummary[]
  paymentCalculations     PaymentWorkerCalculation[]

  @@unique([workerId, locationId])
  @@index([locationId])
}

model EvaluatingOfficerAssignment {
  id         String   @id @default(cuid())
  userId     String
  locationId String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([userId, locationId])
  @@index([locationId])
}

model PHIAssignment {
  id         String   @id @default(cuid())
  userId     String
  locationId String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([userId, locationId])
  @@index([locationId])
}

model DailyCleaningEvaluation {
  id                  String           @id @default(cuid())
  locationId          String
  locationTaskId      String
  evaluatingOfficerId String
  evaluationDate      DateTime
  occurrenceKey       String           @default("default")
  result              EvaluationResult
  remark              String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  finalizedAt         DateTime?
  lockedAt            DateTime?

  location          Location     @relation(fields: [locationId], references: [id])
  locationTask      LocationTask @relation(fields: [locationTaskId], references: [id])
  evaluatingOfficer User         @relation(fields: [evaluatingOfficerId], references: [id])

  @@unique([locationTaskId, evaluationDate, occurrenceKey])
  @@index([locationId])
  @@index([evaluatingOfficerId])
  @@index([evaluationDate])
}

model WorkerAttendance {
  id               String           @id @default(cuid())
  workerId         String
  locationId       String
  phiUserId        String
  attendanceDate   DateTime
  attendanceStatus AttendanceStatus
  remark           String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  finalizedAt      DateTime?
  lockedAt         DateTime?

  worker   CleaningWorker @relation(fields: [workerId], references: [id])
  location Location       @relation(fields: [locationId], references: [id])
  phiUser  User           @relation(fields: [phiUserId], references: [id])

  @@unique([workerId, locationId, attendanceDate])
  @@index([locationId])
  @@index([workerId])
  @@index([attendanceDate])
}

model DailyAttendanceEvaluation {
  id                String   @id @default(cuid())
  locationId        String
  phiUserId         String
  attendanceDate    DateTime
  totalPresentCount  Int
  remark            String?
  finalized         Boolean  @default(false)
  finalizedAt       DateTime?
  lockedAt          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  location  Location @relation(fields: [locationId], references: [id])
  phiUser   User     @relation(fields: [phiUserId], references: [id])

  @@unique([locationId, attendanceDate])
  @@index([locationId])
  @@index([phiUserId])
  @@index([attendanceDate])
}

model MonthlyEvaluationReport {
  id              String       @id @default(cuid())
  locationId      String
  month           Int
  year            Int
  status          ReportStatus @default(DRAFT)
  isComplete      Boolean      @default(true)
  processingError String?
  attendanceHistory Json?
  generatedAt     DateTime?
  submittedAt     DateTime?
  resubmittedAt   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  location              Location               @relation(fields: [locationId], references: [id])
  taskSummaries         MonthlyTaskSummary[]
  workerSummaries       MonthlyWorkerSummary[]
  administrationReviews AdministrationReview[]
  paymentRecommendation PaymentRecommendation?

  @@unique([locationId, month, year])
  @@index([month, year])
  @@index([status])
}

model PhiMonthlyAttendanceReport {
  id              String       @id @default(cuid())
  phiUserId       String
  month           Int
  year            Int
  status          ReportStatus @default(DRAFT)
  processingError String?
  grandTotal      Decimal      @db.Decimal(15, 2) @default(0)
  generatedAt     DateTime?
  submittedAt     DateTime?
  resubmittedAt   DateTime?
  finalizedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  phiUser         User                           @relation(fields: [phiUserId], references: [id])
  rows            PhiMonthlyAttendanceSummary[]
  reviews         PhiMonthlyAttendanceReview[]

  @@unique([phiUserId, month, year])
  @@index([month, year])
  @@index([status])
}

model PhiMonthlyAttendanceSummary {
  id            String                         @id @default(cuid())
  reportId      String
  category      PhiMonthlyAttendanceCategory
  employeeCount Int
  deductionRate Decimal                        @db.Decimal(15, 2)
  rowTotal      Decimal                        @db.Decimal(15, 2)
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt

  report        PhiMonthlyAttendanceReport      @relation(fields: [reportId], references: [id])

  @@unique([reportId, category])
  @@index([reportId])
}

model PhiMonthlyAttendanceReview {
  id         String                 @id @default(cuid())
  reportId   String
  reviewerId String
  decision   AdministrationDecision
  remarks    String?
  reviewedAt DateTime               @default(now())
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  report   PhiMonthlyAttendanceReport @relation(fields: [reportId], references: [id])
  reviewer User                      @relation(fields: [reviewerId], references: [id])

  @@index([reportId])
  @@index([reviewerId])
  @@index([decision])
}

model MonthlyTaskSummary {
  id                      String    @id @default(cuid())
  reportId                String
  locationTaskId          String
  taskNameSnapshot        String
  categorySnapshot        TaskCategory
  frequencySnapshot       TaskFrequency
  allocatedAmount         Decimal   @db.Decimal(15, 2)
  completionPercentage    Decimal   @db.Decimal(5, 2)
  recommendedAmount       Decimal?  @db.Decimal(15, 2)
  expectedOccurrences     Int       @default(0)
  passedOccurrences       Int       @default(0)
  failedOccurrences       Int       @default(0)
  notApplicableOccurrences Int       @default(0)
  missingOccurrences      Int       @default(0)
  evaluationHistory       Json?
  taskRemarks             Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  report           MonthlyEvaluationReport @relation(fields: [reportId], references: [id])
  locationTask     LocationTask            @relation(fields: [locationTaskId], references: [id])
  paymentCalculation PaymentTaskCalculation?

  @@unique([reportId, locationTaskId])
  @@index([locationTaskId])
}

model MonthlyWorkerSummary {
  id                           String    @id @default(cuid())
  reportId                     String
  workerId                     String
  workerLocationAssignmentId    String
  workerNameSnapshot           String
  allocatedAmount              Decimal   @db.Decimal(15, 2)
  recommendedAmount            Decimal   @db.Decimal(15, 2)
  attendancePercentage         Decimal   @db.Decimal(5, 2)
  applicableWorkingDays        Int
  presentWorkingDays           Int       @default(0)
  absentWorkingDays            Int       @default(0)
  missingAttendanceOccurrences Int       @default(0)
  attendanceHistory            Json?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  report                  MonthlyEvaluationReport  @relation(fields: [reportId], references: [id])
  worker                  CleaningWorker           @relation(fields: [workerId], references: [id])
  workerLocationAssignment WorkerLocationAssignment @relation(fields: [workerLocationAssignmentId], references: [id])
  paymentCalculation      PaymentWorkerCalculation?

  @@unique([reportId, workerId])
  @@index([workerLocationAssignmentId])
}

model AdministrationReview {
  id         String                 @id @default(cuid())
  reportId   String
  reviewerId String
  decision   AdministrationDecision
  remarks    String?
  reviewedAt DateTime               @default(now())
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  report   MonthlyEvaluationReport @relation(fields: [reportId], references: [id])
  reviewer User                    @relation(fields: [reviewerId], references: [id])

  @@index([reportId])
  @@index([reviewerId])
  @@index([decision])
}

model PaymentRecommendation {
  id                         String                      @id @default(cuid())
  reportId                   String                      @unique
  createdByUserId            String
  status                     PaymentRecommendationStatus @default(DRAFT)
  version                    Int                         @default(1)
  locationCleaningTotal      Decimal                     @db.Decimal(15, 2)
  locationAttendanceTotal    Decimal                     @db.Decimal(15, 2)
  locationGrandTotal         Decimal                     @db.Decimal(15, 2)
  overallRecommendedPayment  Decimal                     @db.Decimal(15, 2)
  sentToVcAt                 DateTime?
  submittedByUserId          String?
  remarks                    String?
  finalizedAt                DateTime?
  finalizedByUserId          String?
  finalizationRemarks        String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  report             MonthlyEvaluationReport @relation(fields: [reportId], references: [id])
  createdBy          User                    @relation(fields: [createdByUserId], references: [id])
  submittedBy        User?                   @relation("PaymentRecommendationSubmitter", fields: [submittedByUserId], references: [id])
  finalizedBy        User?                   @relation("PaymentRecommendationFinalizer", fields: [finalizedByUserId], references: [id])
  taskCalculations   PaymentTaskCalculation[]
  workerCalculations PaymentWorkerCalculation[]
  additionalTasks    AdditionalCleaningTask[]
  vcApprovals        VCApproval[]

  @@index([status])
  @@index([createdByUserId])
  @@index([finalizedByUserId])
}

model PaymentTaskCalculation {
  id                   String               @id @default(cuid())
  recommendationId     String
  monthlyTaskSummaryId String               @unique
  locationTaskId       String
  originalAmount       Decimal              @db.Decimal(15, 2)
  recommendationAmount Decimal              @db.Decimal(15, 2)
  completionPercentage Decimal              @db.Decimal(5, 2)
  recommendedAmount    Decimal              @db.Decimal(15, 2)
  changedById          String?
  changedAt            DateTime?
  changeReason         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  recommendation      PaymentRecommendation @relation(fields: [recommendationId], references: [id])
  monthlyTaskSummary   MonthlyTaskSummary    @relation(fields: [monthlyTaskSummaryId], references: [id])
  locationTask         LocationTask          @relation(fields: [locationTaskId], references: [id])
  changedBy            User?                @relation(fields: [changedById], references: [id])

  @@unique([recommendationId, locationTaskId])
  @@index([locationTaskId])
  @@index([changedById])
}

model PaymentWorkerCalculation {
  id                        String               @id @default(cuid())
  recommendationId          String
  monthlyWorkerSummaryId    String               @unique
  workerId                  String
  workerLocationAssignmentId String
  originalAmount            Decimal              @db.Decimal(15, 2)
  recommendationAmount      Decimal              @db.Decimal(15, 2)
  attendancePercentage      Decimal              @db.Decimal(5, 2)
  recommendedAmount         Decimal              @db.Decimal(15, 2)
  changedById               String?
  changedAt                 DateTime?
  changeReason              String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  recommendation           PaymentRecommendation    @relation(fields: [recommendationId], references: [id])
  monthlyWorkerSummary     MonthlyWorkerSummary     @relation(fields: [monthlyWorkerSummaryId], references: [id])
  worker                   CleaningWorker           @relation(fields: [workerId], references: [id])
  workerLocationAssignment WorkerLocationAssignment @relation(fields: [workerLocationAssignmentId], references: [id])
  changedBy                User?                    @relation(fields: [changedById], references: [id])

  @@unique([recommendationId, workerId])
  @@index([workerLocationAssignmentId])
  @@index([changedById])
}

model AdditionalCleaningTask {
  id                   String               @id @default(cuid())
  recommendationId     String
  locationId           String
  taskName             String
  category             TaskCategory
  allocatedAmount      Decimal              @db.Decimal(15, 2)
  completionPercentage Decimal              @db.Decimal(5, 2)
  recommendedAmount    Decimal              @db.Decimal(15, 2)
  remark               String?
  isAdditional         Boolean              @default(true)
  createdByUserId      String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  recommendation       PaymentRecommendation @relation(fields: [recommendationId], references: [id])
  location             Location              @relation(fields: [locationId], references: [id])
  createdBy            User?                 @relation(fields: [createdByUserId], references: [id])

  @@index([recommendationId])
  @@index([locationId])
}

model VCApproval {
  id               String                @id @default(cuid())
  recommendationId String
  vcUserId         String
  decision         VCDecision
  remarks          String?
  decidedAt        DateTime              @default(now())
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  recommendation   PaymentRecommendation @relation(fields: [recommendationId], references: [id])
  vcUser           User                  @relation(fields: [vcUserId], references: [id])

  @@index([recommendationId])
  @@index([vcUserId])
  @@index([decision])
}

model ActivityLog {
  id          String         @id @default(cuid())
  userId      String
  action      ActivityAction
  entityType  String
  entityId    String
  timestamp   DateTime       @default(now())
  description String?
  metadata    Json?

  user        User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([timestamp])
}

model Notification {
  id             String             @id @default(cuid())
  recipientUserId String
  event          NotificationEvent
  title          String
  message        String
  entityType     String
  entityId       String
  dedupeKey      String?            @unique
  readAt         DateTime?
  createdAt      DateTime           @default(now())
  metadata       Json?

  recipient      User               @relation(fields: [recipientUserId], references: [id])

  @@index([recipientUserId, readAt])
  @@index([event])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Cleaning monitoring process (BOQ -> evaluation reports -> monthly reports)
// ---------------------------------------------------------------------------

/// One row of a location's Bill of Quantities, e.g. "1 (a) Dust mopping ... Daily 50,000.00".
model BoqItem {
  id            String       @id @default(cuid())
  locationId    String
  /// Item number as printed in the BOQ ("1", "2", "i", "ii").
  itemNo        String
  /// Sub item ("a", "a.I", "Zone 1", "Carpet roads"). Empty when the item has none.
  subItem       String       @default("")
  description   String
  frequency     BoqFrequency
  /// Monthly amount (Rs.) for SCHEDULED items.
  monthlyAmount Decimal      @default(0) @db.Decimal(15, 2)
  /// RATE_BASED items: amount paid per service / per animal.
  unitRate      Decimal?     @db.Decimal(15, 2)
  unitLabel     String?
  /// RATE_BASED items: planned services/animals per year (BOQ "Frequency per year").
  plannedPerYear Int?
  /// RATE_BASED items: fine per unit not delivered (e.g. Rs. 7,500 per animal not removed).
  penaltyRate   Decimal?     @db.Decimal(15, 2)
  /// Extra detail such as pit sizes.
  details       String?
  sortOrder     Int          @default(0)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  location      Location     @relation(fields: [locationId], references: [id])
  reportRows    EvaluationReportRow[]

  @@index([locationId, sortOrder])
}

/// Which login submits the evaluation report of which location.
model ReportingAssignment {
  id         String   @id @default(cuid())
  userId     String
  locationId String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([userId, locationId])
  @@index([locationId])
}

/// Monthly evaluation report of one location (one of the 28 reports).
model EvaluationReport {
  id             String                 @id @default(cuid())
  locationId     String
  year           Int
  month          Int
  status         EvaluationReportStatus @default(DRAFT)
  createdById    String
  submittedById  String?
  submittedAt    DateTime?
  reviewedById   String?
  reviewedAt     DateTime?
  returnReason   String?
  remarks        String?
  boqTotal       Decimal                @default(0) @db.Decimal(15, 2)
  deductionTotal Decimal                @default(0) @db.Decimal(15, 2)
  approvedTotal  Decimal                @default(0) @db.Decimal(15, 2)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  location    Location              @relation(fields: [locationId], references: [id])
  createdBy   User                  @relation("EvaluationReportCreator", fields: [createdById], references: [id])
  submittedBy User?                 @relation("EvaluationReportSubmitter", fields: [submittedById], references: [id])
  reviewedBy  User?                 @relation("EvaluationReportReviewer", fields: [reviewedById], references: [id])
  rows        EvaluationReportRow[]

  @@unique([locationId, year, month])
  @@index([year, month])
  @@index([status])
}

/// A BOQ row inside an evaluation report. BOQ values are copied when the report
/// is started so later BOQ edits never change a report that is in progress.
model EvaluationReportRow {
  id               String       @id @default(cuid())
  reportId         String
  boqItemId        String?
  itemNo           String
  subItem          String       @default("")
  description      String
  frequency        BoqFrequency
  sortOrder        Int          @default(0)
  monthlyAmount    Decimal      @default(0) @db.Decimal(15, 2)
  unitRate         Decimal?     @db.Decimal(15, 2)
  unitLabel        String?
  penaltyRate      Decimal?     @db.Decimal(15, 2)
  /// SCHEDULED rows: number of occurrences in the month and which were done.
  scheduledCount   Int          @default(0)
  completedCount   Int          @default(0)
  completedKeys    Json?
  /// RATE_BASED rows: units delivered and units not delivered (fined).
  quantity         Int?
  penaltyQuantity  Int?
  /// False until the row has been filled in ("fill in the blanks").
  filled           Boolean      @default(false)
  deductionPercent Decimal?     @db.Decimal(5, 2)
  deductionAmount  Decimal      @default(0) @db.Decimal(15, 2)
  totalAmount      Decimal      @default(0) @db.Decimal(15, 2)
  remark           String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  report  EvaluationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  boqItem BoqItem?         @relation(fields: [boqItemId], references: [id], onDelete: SetNull)

  @@unique([reportId, boqItemId])
  @@index([boqItemId])
}

/// PHI daily attendance sheet: number of half-day / absent staff per category.
model PhiDailyAttendance {
  id                  String   @id @default(cuid())
  phiUserId           String
  attendanceDate      DateTime @db.Date
  halfDayEmployees    Int      @default(0)
  halfDayGrassCutters Int      @default(0)
  halfDaySupervisors  Int      @default(0)
  absentEmployees     Int      @default(0)
  absentGrassCutters  Int      @default(0)
  absentSupervisors   Int      @default(0)
  remark              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  phiUser User @relation(fields: [phiUserId], references: [id])

  @@unique([phiUserId, attendanceDate])
  @@index([attendanceDate])
}

/// "Cleaning & Janitorial Services" final monthly report prepared by the DR.
model MonthlyPaymentReport {
  id               String              @id @default(cuid())
  year             Int
  month            Int
  status           PaymentReportStatus @default(DRAFT)
  boqTotal         Decimal             @default(0) @db.Decimal(15, 2)
  invoiceTotal     Decimal             @default(0) @db.Decimal(15, 2)
  approvedTotal    Decimal             @default(0) @db.Decimal(15, 2)
  absenceDeduction Decimal             @default(0) @db.Decimal(15, 2)
  payableTotal     Decimal             @default(0) @db.Decimal(15, 2)
  remarks          String?
  createdById      String
  finalizedById    String?
  finalizedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  createdBy   User                       @relation("PaymentReportCreator", fields: [createdById], references: [id])
  finalizedBy User?                      @relation("PaymentReportFinalizer", fields: [finalizedById], references: [id])
  lines       MonthlyPaymentReportLine[]

  @@unique([year, month])
}

model MonthlyPaymentReportLine {
  id                 String   @id @default(cuid())
  reportId           String
  locationId         String
  boqNumber          Int?
  description        String
  sortOrder          Int      @default(0)
  boqAmount          Decimal  @default(0) @db.Decimal(15, 2)
  invoiceAmount      Decimal  @default(0) @db.Decimal(15, 2)
  approvedAmount     Decimal  @default(0) @db.Decimal(15, 2)
  evaluationReportId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  report   MonthlyPaymentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  location Location             @relation(fields: [locationId], references: [id])

  @@unique([reportId, locationId])
  @@index([locationId])
}
